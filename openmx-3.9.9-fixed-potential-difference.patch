diff --git b/source/Potential_Constraint.c b/source/Potential_Constraint.c
new file mode 100644
index 0000000..8ba95f0
--- /dev/null
+++ b/source/Potential_Constraint.c
@@ -0,0 +1,96 @@
+/**********************************************************************
+  Potential_Constraint.c
+
+  Minimal two-electrode fixed potential-difference implementation.
+***********************************************************************/
+
+#include <stdio.h>
+#include "openmx_common.h"
+#include "mpi.h"
+
+static void electrode_populations(double *nl, double *nr)
+{
+  int i,myid;
+  double left=0.0,right=0.0,data[2];
+
+  MPI_Comm_rank(mpi_comm_level1,&myid);
+  if (myid==Host_ID){
+    for (i=1; i<=atomnum; i++){
+      double n;
+      if (SpinP_switch==0) n = 2.0*InitN_USpin[i];
+      else                 n = InitN_USpin[i] + InitN_DSpin[i];
+      if      (PotentialConstraintGroup[i]==1) left  += n;
+      else if (PotentialConstraintGroup[i]==2) right += n;
+    }
+    data[0]=left;
+    data[1]=right;
+  }
+  MPI_Bcast(data,2,MPI_DOUBLE,Host_ID,mpi_comm_level1);
+  *nl=data[0];
+  *nr=data[1];
+}
+
+void PotentialConstraint_Init(void)
+{
+  PotentialConstraintReferenceSet=0;
+  PotentialConstraintReferenceIter=-1;
+  PotentialConstraintNLeft=PotentialConstraintNRight=0.0;
+  PotentialConstraintNLeft0=PotentialConstraintNRight0=0.0;
+  PotentialConstraintQCurrent=0.0;
+}
+
+void PotentialConstraint_Update(int SCF_iter)
+{
+  int myid;
+  double dnleft,dnright;
+
+  MPI_Comm_rank(mpi_comm_level1,&myid);
+  electrode_populations(&PotentialConstraintNLeft,&PotentialConstraintNRight);
+  if (!PotentialConstraintReferenceSet) return;
+
+  dnleft  = PotentialConstraintNLeft  - PotentialConstraintNLeft0;
+  dnright = PotentialConstraintNRight - PotentialConstraintNRight0;
+  PotentialConstraintQCurrent=0.5*(-dnleft+dnright);
+
+  if (myid==Host_ID && PotentialConstraintOutput){
+    printf("Fixed Potential Difference: iter=%d Vc=%15.8f V Qcurrent=%15.8f dNleft=%15.8f dNright=%15.8f\n",
+           SCF_iter,PotentialConstraintVc,
+           PotentialConstraintQCurrent,dnleft,dnright);
+    fflush(stdout);
+  }
+}
+
+void PotentialConstraint_SetReference(int SCF_iter)
+{
+  int myid;
+  MPI_Comm_rank(mpi_comm_level1,&myid);
+  PotentialConstraintNLeft0=PotentialConstraintNLeft;
+  PotentialConstraintNRight0=PotentialConstraintNRight;
+  PotentialConstraintQCurrent=0.0;
+  PotentialConstraintReferenceSet=1;
+  PotentialConstraintReferenceIter=SCF_iter;
+  if (myid==Host_ID && PotentialConstraintOutput){
+    printf("Potential Constraint: unconstrained reference converged at iter=%d; Nleft0=%15.8f Nright0=%15.8f\n",
+           SCF_iter,PotentialConstraintNLeft0,PotentialConstraintNRight0);
+    fflush(stdout);
+  }
+}
+
+void PotentialConstraint_FinalOutput(void)
+{
+  int myid;
+  MPI_Comm_rank(mpi_comm_level1,&myid);
+  electrode_populations(&PotentialConstraintNLeft,&PotentialConstraintNRight);
+  if (PotentialConstraintReferenceSet){
+    PotentialConstraintQCurrent=0.5*(-(PotentialConstraintNLeft-PotentialConstraintNLeft0)
+                                  +(PotentialConstraintNRight-PotentialConstraintNRight0));
+  }
+  if (myid==Host_ID){
+    printf("\nFixed Potential-Difference Final Summary\n");
+    printf("Reference electrons: left=%15.8f right=%15.8f\n",PotentialConstraintNLeft0,PotentialConstraintNRight0);
+    printf("Current electrons:   left=%15.8f right=%15.8f\n",PotentialConstraintNLeft,PotentialConstraintNRight);
+    printf("Transferred charge:  %15.8f electron\n",PotentialConstraintQCurrent);
+    printf("Constraint difference Vc: %15.8f V\n\n",PotentialConstraintVc);
+    fflush(stdout);
+  }
+}
diff --git a/source/Set_Hamiltonian.c b/source/Set_Hamiltonian.c
index e00b740..0433b5e 100755
--- a/source/Set_Hamiltonian.c
+++ b/source/Set_Hamiltonian.c
@@ -161,9 +161,39 @@ double Set_Hamiltonian(char *mode,
       }
     }
 
-  }
-
-  if(measure_time){ 
+  }
+
+  /***************************************************************
+    Two-group charge constraint.  A piecewise constant local
+    potential is represented in the non-orthogonal AO basis by
+                 1/2 (V_A + V_B) S_{A mu,B nu}.
+    PotentialConstraintVc is specified in eV; Hamiltonians use Hartree.
+  ***************************************************************/
+
+  if (PotentialConstraintDFT && PotentialConstraintReferenceSet){
+    for (Mc_AN=1; Mc_AN<=Matomnum; Mc_AN++){
+      double vA,vB,dv;
+      Gc_AN = M2G[Mc_AN];
+      Cwan = WhatSpecies[Gc_AN];
+      vA = (PotentialConstraintGroup[Gc_AN]==1 ?  0.5*PotentialConstraintVc :
+            PotentialConstraintGroup[Gc_AN]==2 ? -0.5*PotentialConstraintVc : 0.0);
+      for (h_AN=0; h_AN<=FNAN[Gc_AN]; h_AN++){
+        Gh_AN = natn[Gc_AN][h_AN];
+        Hwan = WhatSpecies[Gh_AN];
+        vB = (PotentialConstraintGroup[Gh_AN]==1 ?  0.5*PotentialConstraintVc :
+              PotentialConstraintGroup[Gh_AN]==2 ? -0.5*PotentialConstraintVc : 0.0);
+        dv = 0.5*(vA+vB)/eV2Hartree;
+        for (i=0; i<Spe_Total_NO[Cwan]; i++){
+          for (j=0; j<Spe_Total_NO[Hwan]; j++){
+            H[0][Mc_AN][h_AN][i][j] += dv*OLP[0][Mc_AN][h_AN][i][j];
+            if (SpinP_switch!=0) H[1][Mc_AN][h_AN][i][j] += dv*OLP[0][Mc_AN][h_AN][i][j];
+          }
+        }
+      }
+    }
+  }
+
+  if(measure_time){ 
     dtime(&time2);
     printf("myid=%4d Time1=%18.10f\n",myid,time2-time1);fflush(stdout);
   }
